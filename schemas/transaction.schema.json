{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostlimbriders.org/schemas/transaction.schema.json",
  "title": "Lost Limb Riders proposed transaction",
  "description": "A proposed operational record extracted from a voice or text submission. AI-generated records remain drafts until approved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_type",
    "occurred_at",
    "counterparty",
    "items",
    "amount_paid",
    "currency",
    "purpose",
    "received_by",
    "notes",
    "amount_received"
  ],
  "properties": {
    "transaction_type": {
      "type": "string",
      "enum": [
        "donation_received",
        "purchase_received",
        "reimbursement_requested",
        "inventory_used",
        "inventory_adjustment",
        "cash_contribution",
        "equipment_received"
      ]
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "counterparty": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "donor",
            "supplier",
            "volunteer",
            "attendee",
            "other",
            null
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "quantity",
          "unit"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "food_beverage",
              "serving_supplies",
              "cleaning_supplies",
              "merchandise",
              "equipment",
              "office_supplies",
              "other",
              null
            ]
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "package_count": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "units_per_package": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "condition": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "new_unopened",
              "usable",
              "perishable_check",
              "damaged",
              "unknown",
              null
            ]
          },
          "expiration_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "adjustment_direction": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "increase",
              "decrease",
              null
            ],
            "description": "Required for inventory_adjustment transactions; determines whether stock increases or decreases."
          }
        }
      }
    },
    "amount_paid": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Amount actually paid by the organization. Use 0 only when the speaker explicitly says no payment was made. Use null when unknown."
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "received_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_or_ambiguous": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_transcript": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original transcription; preserve separately from normalized fields."
    },
    "amount_received": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Cash contributions received by the organization. Required as a positive amount for cash_contribution; null for all other transaction types."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transaction_type": {
            "const": "cash_contribution"
          }
        },
        "required": [
          "transaction_type"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          },
          "amount_paid": {
            "type": "null"
          },
          "amount_received": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transaction_type": {
            "const": "donation_received"
          }
        },
        "required": [
          "transaction_type"
        ]
      },
      "then": {
        "properties": {
          "amount_paid": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transaction_type": {
            "const": "inventory_adjustment"
          }
        },
        "required": [
          "transaction_type"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "adjustment_direction"
              ],
              "properties": {
                "adjustment_direction": {
                  "type": "string",
                  "enum": [
                    "increase",
                    "decrease"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transaction_type": {
            "not": {
              "const": "cash_contribution"
            }
          }
        },
        "required": [
          "transaction_type"
        ]
      },
      "then": {
        "properties": {
          "amount_received": {
            "type": "null"
          }
        }
      }
    }
  ]
}
